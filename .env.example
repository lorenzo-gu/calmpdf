# Google AdSense — leave these unset to disable ads entirely (dev/preview default).
# Once your AdSense account is approved and you have a publisher ID and
# ad unit slot IDs, set these vars in production (e.g. Vercel env vars).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_HEADER_SLOT=
NEXT_PUBLIC_ADSENSE_IN_ARTICLE_SLOT=
NEXT_PUBLIC_ADSENSE_FOOTER_SLOT=
