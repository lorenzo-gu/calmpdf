{
  "name": "calmpdf",
  "version": "0.1.0",
  "private": true,
  "description": "CalmPDF — simple, private, browser-based PDF tools.",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-pdfjs-worker.mjs",
    "build": "next build",
    "prebuild": "node scripts/copy-pdfjs-worker.mjs && node scripts/verify-pdfjs-assets.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:pdfjs-assets": "node scripts/copy-pdfjs-worker.mjs && node scripts/verify-pdfjs-assets.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.15",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
